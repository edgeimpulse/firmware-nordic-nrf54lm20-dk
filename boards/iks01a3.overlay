/*
 * X-NUCLEO-IKS01A3 sensors wired directly to i2c22 (not used as a shield).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

&i2c22 {
    lis2dw12: lis2dw12@19 {
        compatible = "st,lis2dw12";
        status = "okay";
        reg = < 0x19 >;
    };
    lsm6dso: lsm6dso@6b {
        compatible = "st,lsm6dso";
        status = "okay";
        reg = < 0x6b >;
    };
};
