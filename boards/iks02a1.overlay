/*
 * X-NUCLEO-IKS02A1 sensors wired directly to i2c22 (not used as a shield).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

&i2c22 {
    iis2dlpc: iis2dlpc@19 {
        compatible = "st,iis2dlpc";
        status = "okay";
        reg = < 0x19 >;
    };
    ism330dhcx: ism330dhcx@6b {
        compatible = "st,ism330dhcx";
        status = "okay";
        reg = < 0x6b >;
    };
};
